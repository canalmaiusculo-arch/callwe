# ===========================================
# CallWe — Variáveis de ambiente
# Copie para .env e preencha. NUNCA commitar .env real.
# ===========================================

# ----- Ambiente -----
NODE_ENV=development
APP_NAME=callwe
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
LOG_LEVEL=debug

# ----- Banco de dados -----
DATABASE_URL=postgresql://callwe:callwe@localhost:5432/callwe?schema=public
# Para produção, exigir sslmode=require

# ----- Redis (cache, filas, pub/sub) -----
REDIS_URL=redis://localhost:6379

# ----- Auth / JWT -----
# Gerar com: openssl rand -base64 64
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
NEXTAUTH_SECRET=change-me-nextauth
NEXTAUTH_URL=http://localhost:3000
# Criptografia de credenciais no banco (integrations.credentials)
ENCRYPTION_KEY=change-me-32-bytes-hex

# ----- CORS -----
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ----- Storage (gravações, anexos) -----
# Cloudflare R2 ou AWS S3
S3_ENDPOINT=https://xxxxx.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=callwe-recordings
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL_BASE=https://cdn.callwe.app
# Expiração de presigned URLs em segundos
S3_PRESIGNED_TTL=3600

# ----- Email (convites, recuperação) -----
SMTP_HOST=smtp.postmarkapp.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CallWe <no-reply@callwe.app>"

# ----- CloudTalk -----
# https://my.cloudtalk.io/ → Account Settings → API Keys
CLOUDTALK_API_KEY_ID=
CLOUDTALK_API_KEY_SECRET=
CLOUDTALK_API_BASE_URL=https://api.cloudtalk.io/v1
# Phone SDK (iframe)
CLOUDTALK_PHONE_PARTNER_ID=
# Secret usado para validar assinatura dos webhooks recebidos
CLOUDTALK_WEBHOOK_SECRET=
# URL pública do endpoint HTTP Request Step (briefing pré-chamada)
CLOUDTALK_CALLFLOW_CALLBACK_URL=https://api.callwe.app/cloudtalk/call-flow/incoming

# ----- Meta / Facebook (Lead Ads) -----
# https://developers.facebook.com/apps/
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v20.0
META_OAUTH_REDIRECT_URL=https://api.callwe.app/integrations/meta-ads/callback
# Token de verificação do webhook leadgen (string aleatória que você escolhe)
META_WEBHOOK_VERIFY_TOKEN=change-me-random
# System user token (para buscar leads após OAuth)
META_SYSTEM_USER_TOKEN=

# ----- Google Calendar / Gmail (opcional, fase 2) -----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=

# ----- WhatsApp Cloud API (fase 2) -----
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# ----- Transcrição (fallback se não usar CloudTalk AI) -----
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_SUMMARY_MODEL=gpt-4o-mini

# ----- Observabilidade -----
SENTRY_DSN_API=
SENTRY_DSN_WEB=
SENTRY_DSN_WORKER=
SENTRY_ENV=development

# ----- Billing (fase 2, se cobrar das agências) -----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ----- Rate limiting / segurança -----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
# IPs confiáveis atrás do proxy (Cloudflare ranges)
TRUST_PROXY=true

# ----- Feature flags -----
FEATURE_AI_TRANSCRIPTION=true
FEATURE_META_ADS=true
FEATURE_WHATSAPP=false
FEATURE_BILLING=false
