# =====================================================
# Produção — preencher no /opt/callwe/infra/.env
# Este arquivo NÃO vai para o git.
# =====================================================

# GHCR / imagens
GHCR_OWNER=your-org
IMAGE_TAG=latest

# Postgres
POSTGRES_USER=callwe_app
POSTGRES_PASSWORD=__generate_with_openssl_rand__
POSTGRES_DB=callwe
DATABASE_URL=postgresql://callwe_app:__same_password__@postgres:5432/callwe?schema=public

# Redis
REDIS_PASSWORD=__generate__
REDIS_URL=redis://:__same_password__@redis:6379

# URLs públicas
APP_URL=https://app.callwe.app
API_URL=https://api.callwe.app
CORS_ALLOWED_ORIGINS=https://app.callwe.app

# JWT / crypto
JWT_ACCESS_SECRET=__openssl rand -base64 64__
JWT_REFRESH_SECRET=__openssl rand -base64 64__
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
ENCRYPTION_KEY=__openssl rand -hex 32__
NEXTAUTH_SECRET=__openssl rand -base64 64__

# S3 / R2
S3_ENDPOINT=https://xxxxx.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=callwe-prod
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL_BASE=https://cdn.callwe.app

# CloudTalk
CLOUDTALK_API_KEY_ID=
CLOUDTALK_API_KEY_SECRET=
CLOUDTALK_API_BASE_URL=https://api.cloudtalk.io/v1
CLOUDTALK_PHONE_PARTNER_ID=
CLOUDTALK_WEBHOOK_SECRET=
CLOUDTALK_CALLFLOW_CALLBACK_URL=https://api.callwe.app/api/cloudtalk/call-flow/incoming

# Meta
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v20.0
META_OAUTH_REDIRECT_URL=https://api.callwe.app/api/integrations/meta-ads/callback
META_WEBHOOK_VERIFY_TOKEN=__random__
META_SYSTEM_USER_TOKEN=

# Email
SMTP_HOST=smtp.postmarkapp.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CallWe <no-reply@callwe.app>"

# AI (opcional)
OPENAI_API_KEY=

# Observabilidade
SENTRY_DSN_API=
SENTRY_DSN_WEB=
SENTRY_DSN_WORKER=
SENTRY_ENV=production

# Feature flags
FEATURE_AI_TRANSCRIPTION=true
FEATURE_META_ADS=true
