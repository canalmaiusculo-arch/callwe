{
  "name": "callwe",
  "version": "0.1.0",
  "private": true,
  "description": "CallWe — Multi-tenant call center framework on top of CloudTalk",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "pnpm --filter @callwe/db generate",
    "db:migrate": "pnpm --filter @callwe/db migrate:dev",
    "db:migrate:deploy": "pnpm --filter @callwe/db migrate:deploy",
    "db:seed": "pnpm --filter @callwe/db seed",
    "db:studio": "pnpm --filter @callwe/db studio",
    "docker:dev": "docker compose -f infra/docker-compose.yml up -d",
    "docker:dev:down": "docker compose -f infra/docker-compose.yml down",
    "docker:dev:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@types/node": "^20.16.10",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
